FROM dunglas/frankenphp:1.13-php8.5 AS runner

COPY --from=composer/composer:latest-bin /composer /usr/bin/composer

# Tooling layer: stable, cached independently of the extension compilation.
# Build dependencies are deliberately NOT installed here.
RUN set -ex \
    && curl -fsSL https://deb.nodesource.com/setup_lts.x | bash - \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        wget supervisor unzip p7zip qpdf zip \
        procps curl imagemagick ghostscript strace tcpdump jq nano \
        make time traceroute iputils-ping telnet dnsutils net-tools \
        netcat-openbsd mtr-tiny nodejs \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* \
    && npm install -g chokidar-cli \
    && mkdir -p /config/psysh

# Extensions layer: FrankenPHP is a ZTS PHP build, so install-php-extensions
# has no prebuilt binaries and compiles every extension from source. Keeping
# it in its own layer means tooling or config edits never recompile anything.
# build-essential is purged in the same layer so it never reaches the image.
# excimer is unavailable for PHP 8.5.
RUN set -ex \
    && apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && export CFLAGS="-fPIC -DPIC -O1" CXXFLAGS="-fPIC -DPIC -O1" \
    && install-php-extensions \
        pdo_mysql pdo_pgsql gd intl zip mysqli bcmath \
        redis imagick pcntl soap exif calendar sockets \
        memcached mongodb yaml igbinary amqp imap mailparse \
    && apt-get purge -y --auto-remove build-essential \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Application config and hardening last: the cheapest layers to rebuild.
COPY docker/php.ini /usr/local/etc/php/conf.d/99-custom.ini
COPY docker/caddy/ /etc/frankenphp/hardening/
