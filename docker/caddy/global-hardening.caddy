# kirimemail/frankenphp-extended - server-level (Caddy) hardening
#
# Installed at: /etc/frankenphp/hardening/global-hardening.caddy
#
# STATUS: enabled by default. The bundled Caddyfile (/etc/frankenphp/Caddyfile)
# already imports this snippet - do NOT re-import it.
#
# The {$CADDY_GLOBAL_OPTIONS} splice remains for YOUR OWN additive directives
# only. Re-importing this snippet via env crash-loops Caddy at startup:
#
#   adapting config using caddyfile: cannot have 'servers' global options
#   with duplicate listener addresses
#
# Only import this snippet explicitly when you mount your OWN Caddyfile
# (which replaces the bundled one and therefore doesn't include it):
#
#     {
#         import /etc/frankenphp/hardening/global-hardening.caddy
#     }

# Keep the admin API on the loopback interface. Never publish port 2019.
admin localhost:2019

servers {
	# Caddy accepts 1MB of request headers by default - far more than any
	# legitimate client sends. Bounds header-flooding / memory pressure.
	max_header_size 64KB

	# Slowloris protection: a client that stalls while sending request headers
	# is dropped instead of holding a connection (Caddy waits forever by default).
	timeouts {
		read_header 10s
		idle 120s
		# read_body is intentionally not set: it is a hard cap on the whole
		# body transfer and aborts slow but healthy uploads. FrankenPHP already
		# cuts *stalled* uploads after 60s via php_server request_body_timeout.
		#
		# write_body is left off as well - it truncates long downloads, SSE and
		# Mercure streams.
	}

	# Optional, per deployment:
	#   strict_sni_host on                       (reject Host != SNI)
	#   trusted_proxies static 10.0.0.0/8        (only trust X-Forwarded-* here)
}
