# kirimemail/frankenphp-extended - response header hardening for PHP sites
#
# Installed at: /etc/frankenphp/hardening/security-headers.caddy
#
# STATUS: enabled by default. The bundled Caddyfile (/etc/frankenphp/Caddyfile)
# already imports this snippet (before `php_server`) - do NOT re-import it.
#
# The {$CADDY_SERVER_EXTRA_DIRECTIVES} splice remains for YOUR OWN additive
# directives only. Re-importing the hardening snippets via env crash-loops
# Caddy at startup, e.g.:
#
#   adapting config using caddyfile: matcher is defined more than once:
#   @immutable_hash
#
# Only import this snippet explicitly when you mount your OWN Caddyfile
# (which replaces the bundled one and therefore doesn't include it):
#
#     example.com {
#         import /etc/frankenphp/hardening/security-headers.caddy
#         php_server
#     }
#
# `defer` makes the operations run when the response is written, so headers set
# by the PHP application itself are stripped as well.
header {
	defer

	-Server
	-X-Powered-By

	X-Content-Type-Options "nosniff"
	X-Frame-Options "SAMEORIGIN"
	Referrer-Policy "strict-origin-when-cross-origin"
	Cross-Origin-Opener-Policy "same-origin-allow-popups"
	Cross-Origin-Resource-Policy "same-site"
	Strict-Transport-Security "max-age=31536000; includeSubDomains"
	Permissions-Policy "accelerometer=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"

	# Optional, per application - disabled because both break common patterns:
	#   Content-Security-Policy "default-src 'self'"              (needs a policy
	#       tailored to your assets, inline scripts and API origins)
	#   Cross-Origin-Embedder-Policy "require-corp"               (breaks
	#       third-party images/fonts that lack CORP headers)
}
