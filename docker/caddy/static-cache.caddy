# kirimemail/frankenphp-extended - static asset cache control
#
# Installed at: /etc/frankenphp/hardening/static-cache.caddy
#
# Usage - import it inside your site block, alongside the security headers:
#
#     example.com {
#         import /etc/frankenphp/hardening/security-headers.caddy
#         import /etc/frankenphp/hardening/static-cache.caddy
#         php_server
#     }
#
# Without your own Caddyfile, the stock image splices
# {$CADDY_SERVER_EXTRA_DIRECTIVES} into every site block. Stack both imports
# with a real newline (docker-compose YAML interprets \n inside quotes):
#
#   - CADDY_SERVER_EXTRA_DIRECTIVES="import /etc/frankenphp/hardening/security-headers.caddy\nimport /etc/frankenphp/hardening/static-cache.caddy"
#
# Only responses for static file extensions are touched: HTML, extensionless
# routes, API responses and PHP output keep whatever Cache-Control your app
# sets (or none). Caddy's file server already emits ETag/Last-Modified and
# answers conditional requests with 304, so revalidation works out of the box.

# Fingerprinted assets (Vite/Webpack output like app-a1b2c3d4.js): the hash
# changes on every rebuild, so a year-long immutable cache is always safe.
@immutable_hash {
	path_regexp hashed \.[0-9a-fA-F]{8,}\.[a-z0-9]{2,5}$
}
header @immutable_hash Cache-Control "public, max-age=31536000, immutable"

# Query-versioned statics (Symfony asset versioning: style.css?v=2): the URL
# is the cache key, so each version caches independently for a year. Scoped
# to static extensions - API routes with query strings are never matched.
@immutable_qs {
	path *.css *.js *.mjs *.map *.ico *.png *.jpg *.jpeg *.gif *.svg *.webp *.avif *.bmp *.woff *.woff2 *.ttf *.eot *.otf *.mp4 *.webm *.ogv *.mp3 *.ogg *.wav *.flac *.pdf *.txt *.xml *.webmanifest *.json *.zip
	expression {query} != ''
}
header @immutable_qs Cache-Control "public, max-age=31536000, immutable"

# Plain static files (images, fonts, media): cache a day, then revalidate
# against ETag/Last-Modified. The `not` lines keep this disjoint from the
# immutable rules above so a response never gets two Cache-Control headers.
# If 24h is too slow for your deploys, serve those files with hashed
# filenames or a ?v= query so they graduate to the immutable tiers.
@static {
	path *.css *.js *.mjs *.map *.ico *.png *.jpg *.jpeg *.gif *.svg *.webp *.avif *.bmp *.woff *.woff2 *.ttf *.eot *.otf *.mp4 *.webm *.ogv *.mp3 *.ogg *.wav *.flac *.pdf *.txt *.xml *.webmanifest *.json *.zip
	not path_regexp hashed \.[0-9a-fA-F]{8,}\.[a-z0-9]{2,5}$
	not expression {query} != ''
}
header @static Cache-Control "public, max-age=86400"
